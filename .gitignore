/target
/dist
*.app
.DS_Store

# python classifier cache
tests/golden/__pycache__/

# Keygen build output (the tool is a separate workspace under tools/)
tools/*/target/

# The plugin is its own workspace, so its target directory is its own too.
# NO trailing slash: like the root one it is a SYMLINK out of Dropbox, and
# `plugin/target/` matches a directory only — so the symlink itself was tracked,
# and a fresh clone got a link pointing at a cache path on one particular Mac.
plugin/target

# Installer staging. Kept out of the repo AND out of Dropbox by
# scripts/build-installer.sh, which stages in a temp dir; this catches the
# case where someone points it somewhere else.
#
# `build/*` and not `build/`, deliberately: git will not descend into an
# excluded DIRECTORY, so a `!build/macos/` negation under `build/` is silently
# powerless. Excluding the children instead is what makes the negation work.
build/*
# ...but NOT the macOS signing inputs, which are source.
#
# `scripts/build-macos.sh` fails fast if `build/macos/tangent.entitlements` is
# missing, so without this a fresh clone cannot build the app at all — and the
# file was untracked from the day it was written, because it happened to land
# under a directory ignored for a completely unrelated reason.
!build/macos/
