+    /// Initializes streaming I/O mode with a specific number of buffers.
+    ///
+    /// [`ReadStream::dequeue`] holds a buffer for as long as its callback runs, so the
+    /// default of two leaves the driver exactly one to fill while the application looks
+    /// at a frame. A frame arriving in that window has nowhere to go and overwrites one
+    /// the application has not read yet. More buffers convert that loss into latency,
+    /// at the cost of one frame's memory each.
+    ///
+    /// The driver may allocate fewer than requested; [`ReadStream::buffer_count`]
+    /// reports how many it actually got.
+    pub fn into_stream_with(self, buffer_count: u32) -> io::Result<ReadStream> {
         Ok(ReadStream::new(
             self.file,
             BufType::VIDEO_CAPTURE,
             Memory::MMAP,
-            DEFAULT_BUFFER_COUNT,
+            buffer_count,
         )?)
     }
 }
